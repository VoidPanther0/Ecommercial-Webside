---
import type { Product } from '../types/commerce';
import { getCategory, isAvailable, minPrice } from '../lib/catalog';
import { formatMoney } from '../lib/money';
import PriceDisplay from './PriceDisplay.astro';

interface Props {
  product: Product;
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const category = getCategory(product.category);
const available = isAvailable(product);
const image = product.images[0];
---

<article
  class="product-card"
  data-product-card
  data-title={product.title.toLowerCase()}
  data-category={product.category}
  data-tags={product.tags.join(' ')}
  data-price={minPrice(product)}
  data-featured={String(product.featured)}
  data-available={String(available)}
>
  <a class="product-card-media" href={`/products/${product.handle}/`}>
    <img
      src={image.src}
      alt={image.alt}
      width="900"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="product-card-body">
    <p class="product-card-category">{category?.name ?? product.category}</p>
    <h3><a href={`/products/${product.handle}/`}>{product.title}</a></h3>
    <PriceDisplay price={minPrice(product)} compareAtPrice={product.variants.find((v) => v.compareAtPrice)?.compareAtPrice} />
    <div class="product-card-actions">
      <a class="btn btn-secondary" href={`/products/${product.handle}/`}>View product</a>
      <button
        type="button"
        class="btn btn-icon wishlist-toggle"
        data-wishlist-toggle={product.id}
        aria-label={`Add ${product.title} to wishlist`}
        aria-pressed="false"
      >Save</button>
    </div>
    {!available && <p class="availability">Currently unavailable</p>}
  </div>
</article>

<script>
  import { hasId, toggleId, WISHLIST_KEY } from '../lib/cart';

  function syncWishlistButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-wishlist-toggle]').forEach((button) => {
      const id = button.dataset.wishlistToggle ?? '';
      const saved = hasId(WISHLIST_KEY, id);
      button.setAttribute('aria-pressed', String(saved));
      button.textContent = saved ? 'Saved' : 'Save';
    });
  }

  syncWishlistButtons();
  window.addEventListener('wishlist:change', syncWishlistButtons);

  document.querySelectorAll<HTMLButtonElement>('[data-wishlist-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.wishlistToggle ?? '';
      toggleId(WISHLIST_KEY, id);
      window.dispatchEvent(new CustomEvent('wishlist:change'));
    });
  });
</script>
